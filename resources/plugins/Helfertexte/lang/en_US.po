msgid "config.api_key.info"
msgstr "The API key is used to protect access to the Helfersystem /metrics endpoint. It has no restrictions on length or character classes and must be included in the HTTP request as the request parameter api_key."

msgid "config.app_key.info"
msgstr "Random, long (at least 32 characters) alphanumeric or base64 encoded key, used for signing i.e. JWT tokens to join helper types by link."

msgid "config.enable_dect.info"
msgstr "Enables DECT numbers for users, locations and helper types"

msgid "config.join_qr_code.info"
msgstr "Allow joining a helper type via generated QR code, requires app_key"

msgid "config.jwt_expiration_time.info"
msgstr "Number of minutes after a JWT must expire, for example max helper type join time"

msgid "config.maintenance.info"
msgstr "If enabled it takes the Helfersystem offline for maintenance and shows a static page to all requests"

msgid "config.supporters_can_promote.info"
msgstr "Supporters of a helper type (team) can promote other users of the helper type to supporter"

msgid "freeload.freeloaded.info"
