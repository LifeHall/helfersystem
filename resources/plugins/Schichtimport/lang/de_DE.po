msgid "schichtimport.menu"
msgstr "Schichtimport"

msgid "schichtimport.title"
msgstr "Schichtimport"

msgid "schichtimport.intro"
msgstr "Schichten und die benötigten Personen aus einer Excel-Datei anlegen, z. B. für das nächste Jahr. Die Datei wird zuerst geprüft, erst danach werden die Schichten angelegt."

msgid "schichtimport.step.template"
msgstr "Vorlage herunterladen und ausfüllen"

msgid "schichtimport.template.text"
msgstr "Pro Zeile ein benötigter Helfertyp einer Schicht. Das Blatt „Anleitung“ in der Vorlage erklärt die Spalten."

msgid "schichtimport.template.empty"
msgstr "Leere Vorlage"

msgid "schichtimport.template.existing"
msgstr "Oder die bestehenden Schichten (%s – %s) als Vorlage verwenden und anpassen:"

msgid "schichtimport.template.days"
msgstr "Datum verschieben um (Tage)"

msgid "schichtimport.template.days_info"
msgstr "364 Tage = gleicher Wochentag ein Jahr später, 0 = Datum unverändert."

msgid "schichtimport.template.download_existing"
msgstr "Vorlage mit bestehenden Schichten"

msgid "schichtimport.step.upload"
msgstr "Datei prüfen und importieren"

msgid "schichtimport.file"
msgstr "Datei (Excel .xlsx oder CSV)"

msgid "schichtimport.default_shift_type"
msgstr "Standard-Schichttyp"

msgid "schichtimport.default_shift_type.info"
msgstr "Für Zeilen ohne Schichttyp."

msgid "schichtimport.create_missing"
msgstr "Fehlende Orte, Helfertypen und Schichttypen anlegen"

msgid "schichtimport.check"
msgstr "Prüfen"

msgid "schichtimport.check.info"
msgstr "Es wird noch nichts angelegt."

msgid "schichtimport.imports"
msgstr "Bisherige Importe"

msgid "schichtimport.imports.none"
msgstr "Noch keine Importe."

