{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ __('tagesplan.title') }}{% endblock %}

{% block content %}
    <style>
        .tagesplan { --tp-border: #6c757d; border-collapse: collapse; width: auto; font-size: .85rem; line-height: 1.25; }
        .tagesplan th, .tagesplan td { border: 1px solid var(--tp-border); padding: .1rem .35rem; white-space: nowrap; }
        .tagesplan thead th { text-align: center; background: var(--bs-body-bg); position: sticky; top: 0; z-index: 2; font-size: .75rem; }
        .tagesplan th.tp-label { text-align: left; position: sticky; left: 0; z-index: 1; min-width: 8rem; }
        .tagesplan td { min-width: 4.5rem; }
        {# Long names are shortened, the full name is in the tooltip #}
        .tagesplan td > a { max-width: 10rem; overflow: hidden; text-overflow: ellipsis; }
        .tagesplan tbody.tp-group { border-top: 3px solid var(--tp-border); }
        .tagesplan tbody.tp-group tr > * { color: #212529; }
        {# Header row of a location: darker shade of the location color #}
        .tagesplan tr.tp-location > th {
            background-image: linear-gradient(rgba(0, 0, 0, .5), rgba(0, 0, 0, .5));
            color: #fff; font-weight: 700; font-size: .8em; letter-spacing: .05em; text-transform: uppercase;
            padding-top: .05rem; padding-bottom: .05rem; border-bottom: 2px solid var(--tp-border);
        }
        .tagesplan tbody.tp-group tr.tp-location > * { color: #fff; }
        .tagesplan tr.tp-type-start > * { border-top: 2px solid var(--tp-border); }
        .tagesplan td.tp-none { background-color: #7f7f7f; }
        .tagesplan .tp-open a, .tagesplan .tp-filled a { display: block; color: #212529; text-decoration: none; }
        .tagesplan .tp-open a { color: transparent; }
        .tagesplan .tp-open a:hover, .tagesplan .tp-open a:focus-visible { color: #212529; text-decoration: underline; }
        .tagesplan .tp-filled a:hover { text-decoration: underline; }
        {# Frame around a shift's cells, without the edges where cells of the same shift join (.tp-join-l / -r) #}
        .tagesplan .tp-hover, .tagesplan .tp-active { --tp-w: 2px; --tp-c: #0d6efd; }
        .tagesplan .tp-clicked { --tp-w: 4px; --tp-c: #dc3545; }
        .tagesplan .tp-hover { cursor: pointer; }
        .tagesplan .tp-hover, .tagesplan .tp-active, .tagesplan .tp-clicked {
            box-shadow: inset calc(var(--tp-w) * var(--tp-l, 1)) 0 0 0 var(--tp-c),
                inset calc(-1 * var(--tp-w) * var(--tp-r, 1)) 0 0 0 var(--tp-c),
                inset 0 var(--tp-w) 0 0 var(--tp-c), inset 0 calc(-1 * var(--tp-w)) 0 0 var(--tp-c);
        }
        .tagesplan .tp-join-l { --tp-l: 0; }
        .tagesplan .tp-join-r { --tp-r: 0; }
        {# Handover: narrow column, upper part = previous shift ends, lower part = next shift starts #}
        .tagesplan th.tp-handover-col { min-width: 0; font-size: .75em; line-height: 1.1; }
        .tagesplan td.tp-handover { min-width: 0; padding: 0; font-size: .75em; border-left-style: hidden; border-right-style: hidden; }
        .tagesplan .tp-part { padding: .05rem .3rem; }
        .tagesplan .tp-part + .tp-part { border-top: 1px dashed var(--tp-border); }
        {# Vertical lines only on the half where the shift changes #}
        .tagesplan .tp-part.tp-line-l { border-left: 1px solid var(--tp-border); }
        .tagesplan .tp-part.tp-line-r { border-right: 1px solid var(--tp-border); }
        .tagesplan .tp-part.tp-none { background-color: #7f7f7f; }
        .tagesplan .tp-part.tp-open a, .tagesplan .tp-part.tp-filled a { color: #212529; }
        .tagesplan .tp-part.tp-open a .tp-free { color: transparent; }
        .tagesplan .tp-part.tp-open a:hover .tp-free, .tagesplan .tp-part.tp-open a:focus-visible .tp-free { color: #212529; }
        .tp-color-0 > * { background-color: #d0cece; }
        .tp-color-1 > * { background-color: #b4c6e7; }
        .tp-color-2 > * { background-color: #fbe5d6; }
        .tp-color-3 > * { background-color: #ffd5ff; }
        .tp-color-4 > * { background-color: #c5e0b4; }
        .tp-color-5 > * { background-color: #e2d8d0; }
        .tp-color-6 > * { background-color: #fff2cc; }
        .tp-color-7 > * { background-color: #deebf7; }
        .tp-color-8 > * { background-color: #ededed; }
        .tagesplan .tp-category, .tp-legend .tp-category { -webkit-print-color-adjust: exact; print-color-adjust: exact; font-style: normal; display: inline-block; font-size: .7em; font-weight: 600; color: #fff; border-radius: .25rem; padding: 0 .3rem; margin-left: .3rem; vertical-align: middle; }
        .tagesplan .tp-part .tp-category { width: .6rem; height: .6rem; padding: 0; border-radius: 50%; margin-left: .2rem; }
        .tp-legend span { display: inline-block; width: 1.5rem; height: 1rem; border: 1px solid #6c757d; vertical-align: middle; margin: 0 .25rem 0 1rem; }
        @media print {
            .tagesplan thead th, .tagesplan th.tp-label { position: static; }
            .tagesplan td.tp-open a, .tagesplan .tp-part.tp-open a .tp-free { color: transparent; }
            .tp-color-0 > *, .tp-color-1 > *, .tp-color-2 > *, .tp-color-3 > *, .tp-color-4 > *,
            .tp-color-5 > *, .tp-color-6 > *, .tp-color-7 > *, .tp-color-8 > *, .tagesplan .tp-none {
                -webkit-print-color-adjust: exact; print-color-adjust: exact;
            }
        }
    </style>

    <div class="container-fluid" id="tp-page">
        <h1 class="h3 mb-2">
            {{ block('title') }}
            {% if day %}<small class="text-muted">{{ days[day] }}</small>{% endif %}
        </h1>

        {# When the popup re-opens after an action, it shows the messages itself #}
        {% if not open_shift %}
            {% include 'layouts/parts/messages.twig' %}
        {% endif %}

        {% if days is not empty %}
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2 d-print-none">
                <form method="get" action="{{ url('/tagesplan') }}" class="row g-2 align-items-center">
                    <div class="col-auto">
                        {% if previous_day %}
                            <a href="{{ url('/tagesplan', {'day': previous_day}) }}" class="btn btn-sm btn-secondary"
                                title="{{ __('tagesplan.previous') }}">{{ m.icon('chevron-left') }}</a>
                        {% else %}
                            <span class="btn btn-sm btn-secondary disabled">{{ m.icon('chevron-left') }}</span>
                        {% endif %}
                    </div>
                    <div class="col-auto">
                        <label class="visually-hidden" for="tagesplan-day">{{ __('tagesplan.day') }}</label>
                        <select name="day" id="tagesplan-day" class="form-select form-select-sm">
                            {% for value, label in days %}
                                <option value="{{ value }}" {% if value == day %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-auto">
                        {# Hidden by the script, the day changes on selection #}
                        <button type="submit" class="btn btn-sm btn-primary tp-day-submit">{{ __('tagesplan.show') }}</button>
                    </div>
                    <div class="col-auto">
                        {% if next_day %}
                            <a href="{{ url('/tagesplan', {'day': next_day}) }}" class="btn btn-sm btn-secondary"
                                title="{{ __('tagesplan.next') }}">{{ m.icon('chevron-right') }}</a>
                        {% else %}
                            <span class="btn btn-sm btn-secondary disabled">{{ m.icon('chevron-right') }}</span>
                        {% endif %}
                    </div>
                </form>

                {# Admins and shift coordinators #}
                {% if can('tagesplan.manage') or send_users %}
                    <div class="tp-tools ms-auto d-flex flex-wrap align-items-center gap-2">
                        {% if send_users %}
                            <form method="post" action="{{ url('/startseite/dienste/versenden/person') }}" class="d-flex align-items-center gap-2">
                                {{ csrf() }}
                                <label class="visually-hidden" for="tp-send-user">{{ __('tagesplan.send.person') }}</label>
                                <select name="user_id" id="tp-send-user" class="form-select form-select-sm" required>
                                    <option value="">{{ __('tagesplan.send.person') }}</option>
                                    {% for id, name in send_users %}
                                        <option value="{{ id }}">{{ name }}</option>
                                    {% endfor %}
                                </select>
                                {{ f.button(__('tagesplan.send.button'), {
                                    'type': 'submit',
                                    'size': 'sm',
                                    'btn_type': 'outline-primary',
                                    'icon_left': 'envelope-paper',
                                    'title': __('tagesplan.send.info'),
                                    'confirm_title': __('tagesplan.send.confirm_title'),
                                    'confirm_text': __('tagesplan.send.info'),
                                    'confirm_button_text': __('tagesplan.send.button'),
                                }) }}
                            </form>
                        {% endif %}
                        {% if can('tagesplan.manage') %}
                            {{ m.button(__('tagesplan.excel'), url('/tagesplan/einsatzplan.xlsx'), {'icon_left': 'file-earmark-spreadsheet', 'size': 'sm'}) }}
                            {{ m.button(__('tagesplan.pdf'), url('/tagesplan/einsatzplan.pdf'), {'icon_left': 'file-earmark-pdf', 'size': 'sm'}) }}
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if groups is empty %}
            <div class="alert alert-info">{{ __('tagesplan.no_shifts') }}</div>
        {% else %}
            <div class="table-responsive">
                <table class="tagesplan mb-2">
                    <thead>
                    <tr>
                        <th class="tp-label">{{ __('tagesplan.position') }}</th>
                        {% for column in columns %}
                            {% if column.handover ?? false %}
                                <th class="tp-handover-col">{{ __('tagesplan.handover') }}<br>{{ column.label|replace({' – ': '–'}) }}</th>
                            {% else %}
                                <th>{{ column.label|replace({' – ': '–'}) }}</th>
                            {% endif %}
                        {% endfor %}
                    </tr>
                    </thead>
                    {% for group in groups %}
                        <tbody class="tp-group">
                        {% if group.header %}
                            <tr class="tp-color-{{ group.color }} tp-location">
                                <th class="tp-label">{{ group.location.name }}</th>
                                <th colspan="{{ columns|length }}"></th>
                            </tr>
                        {% endif %}
                        {% for row in group.rows %}
                            <tr class="tp-color-{{ group.color }}{{ row.type_start ? ' tp-type-start' }}">
                                <th class="tp-label">{{ row.label }}</th>
                                {% for cell in row.cells %}
                                    <td class="tp-{{ cell.state }}" {% if cell.colspan > 1 %}colspan="{{ cell.colspan }}"{% endif %}>
                                        {% if cell.state == 'handover' %}
                                            {% set previous_shift = row.cells[loop.index0 - 1].shift_id ?? null %}
                                            {% set next_shift = row.cells[loop.index0 + 1].shift_id ?? null %}
                                            {% for part in cell.parts %}
                                                {% set direction = loop.first ? 'leaving' : 'arriving' %}
                                                <div class="tp-part tp-{{ part.state }}
                                                    {{- previous_shift != part.shift_id ? ' tp-line-l' -}}
                                                    {{- next_shift != part.shift_id ? ' tp-line-r' }}">
                                                    {% if part.state == 'filled' or part.state == 'open' %}
                                                        <a href="{{ part.url }}" data-tp-shift="{{ part.shift_id }}" data-tp-type="{{ part.type_id }}"
                                                            title="{{ __('tagesplan.handover.' ~ direction) }}: {{ part.title }}"
                                                            data-bs-toggle="modal" data-bs-target="#tp-modal">
                                                            {{- m.icon(loop.first ? 'box-arrow-right' : 'box-arrow-in-right') }}
                                                            {% if part.state == 'filled' -%}
                                                                {{ part.name }}
                                                            {%- else -%}
                                                                <span class="tp-free">{{ __('tagesplan.legend.open') }}</span>
                                                            {%- endif -%}
                                                            {%- if part.category %}<i class="tp-category" style="background-color: {{ part.category.color }}" title="{{ part.category.name }}"></i>{% endif -%}
                                                        </a>
                                                    {% else %}
                                                        &nbsp;
                                                    {% endif %}
                                                </div>
                                            {% endfor %}
                                        {% elseif cell.state == 'filled' or cell.state == 'open' %}
                                            <a href="{{ cell.url }}" title="{{ cell.state == 'filled' ? cell.name ~ ' · ' }}{{ cell.title }}" data-tp-shift="{{ cell.shift_id }}" data-tp-type="{{ cell.type_id }}"
                                                data-bs-toggle="modal" data-bs-target="#tp-modal">
                                                {{- cell.state == 'filled' ? cell.name : __('tagesplan.legend.open') -}}
                                                {%- if cell.category %}<span class="tp-category" style="background-color: {{ cell.category.color }}">{{ cell.category.name }}</span>{% endif -%}
                                            </a>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    {% endfor %}
                </table>
            </div>

            <p class="tp-legend small text-muted d-print-none">
                <span style="background-color:#b4c6e7"></span>{{ __('tagesplan.legend.filled') }} / {{ __('tagesplan.legend.open') }}
                <span style="background-color: #7f7f7f"></span>{{ __('tagesplan.legend.none') }}
                {% if categories %}
                    <br>{{ __('tagesplan.legend.categories') }}:
                    {% for category in categories %}
                        <i class="tp-category" style="background-color: {{ category.color }}">{{ category.name }}</i>
                    {% endfor %}
                {% endif %}
                <br>{{ m.icon('box-arrow-right') }} / {{ m.icon('box-arrow-in-right') }} {{ __('tagesplan.legend.handover') }}
            </p>
        {% endif %}
    </div>

    <div class="modal fade" id="tp-modal" tabindex="-1" aria-labelledby="tp-modal-title" aria-hidden="true"
        data-url="{{ url('/tagesplan/schicht') }}" data-title="{{ __('tagesplan.shift') }}"
        data-error="{{ __('tagesplan.loading_error') }}" {% if open_shift %}data-open-shift="{{ open_shift }}" data-open-type="{{ open_type }}"{% endif %}>
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content {{ m.type_bg_class() }}">
                <div class="modal-header">
                    <h5 class="modal-title" id="tp-modal-title">{{ __('tagesplan.shift') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('tagesplan.close') }}"></button>
                </div>
                <div class="modal-body"></div>
                {# Also on small screens, where the popup fills the screen #}
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">{{ __('tagesplan.close') }}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script src="{{ url('/tagesplan/tagesplan.js') }}"></script>
{% endblock %}
