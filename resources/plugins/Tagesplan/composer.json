{
  "type": "engelsystem-plugin",
  "name": "helfersystem/tagesplan",
  "description": "Tagesansicht der Schichten, gruppiert nach Ort",
  "version": "1.9.0",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "befritscht",
      "email": "beat.fritschi@brutsch.com"
    }
  ],
  "extra": {
    "providers": [
      "Helfersystem\\Tagesplan\\ServiceProvider"
    ],
    "routes": {
      "/tagesplan": "Helfersystem\\Tagesplan\\Controller@index",
      "/tagesplan/schicht": "Helfersystem\\Tagesplan\\ShiftPopupController@show",
      "/tagesplan/eintragen": [
        "Helfersystem\\Tagesplan\\ShiftPopupController@signup",
        "POST"
      ],
      "/tagesplan/austragen": [
        "Helfersystem\\Tagesplan\\ShiftPopupController@signoff",
        "POST"
      ],
      "/tagesplan/tagesplan.js": "Helfersystem\\Tagesplan\\ShiftPopupController@script",
      "/tagesplan/freigabe": [
        "Helfersystem\\Tagesplan\\ShiftPopupController@requestApproval",
        "POST"
      ]
    },
    "config_options": {
      "tagesplan": {
        "title": "tagesplan.title",
        "icon": "calendar3",
        "order": 60,
        "config": {
          "tagesplan_order": {
            "type": "text",
            "rows": 12,
            "default": ""
          }
        }
      }
    }
  },
  "autoload": {
    "psr-4": {
      "Helfersystem\\Tagesplan\\": "src/"
    }
  }
}
