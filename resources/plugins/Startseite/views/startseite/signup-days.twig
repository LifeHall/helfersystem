{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ auto|default(false) ? __('startseite.auto.title') : __('startseite.signup.title') }}{% endblock %}

{% block content %}
    <div class="container">
        {% set back = auto ? url('/startseite/eintragen', {'modus': 'auto'}) : url('/startseite/eintragen') %}
        <h1>{{ m.back(back) }} {{ block('title') }}</h1>
        {% include 'startseite/_steps.twig' %}
        {% include 'layouts/parts/messages.twig' %}

        <p>{{ __('startseite.signup.days.info') }}</p>

        <form method="post" action="{{ url('/startseite/eintragen/tage/speichern') }}" id="startseite-days">
            {{ csrf() }}
            {% if auto %}<input type="hidden" name="modus" value="auto">{% endif %}
            <div class="list-group mb-4">
                <label class="list-group-item d-flex gap-3 align-items-center fw-semibold">
                    <input class="form-check-input flex-shrink-0 mt-0" type="checkbox" id="startseite-all">
                    {{ __('startseite.signup.all_days') }}
                </label>
                {% for day, item in days %}
                    <label class="list-group-item d-flex gap-3 align-items-center">
                        <input class="form-check-input flex-shrink-0 mt-0 startseite-day" type="checkbox" name="days[{{ day }}]" value="1"
                            {%- if item.checked %} checked{% endif %}
                            {%- if item.locked %} disabled{% endif %}>
                        <span class="flex-grow-1">{{ item.label }}</span>
                        {% if item.locked %}
                            {# Disabled checkboxes are not sent, the day is kept by the server #}
                            <span class="badge bg-success">{{ m.icon('lock') }} {{ __('startseite.signup.locked') }}</span>
                        {% endif %}
                    </label>
                {% else %}
                    <div class="list-group-item">{{ __('startseite.signup.no_shifts') }}</div>
                {% endfor %}
            </div>

            <div class="d-flex gap-2">
                {{ m.button(__('startseite.signup.back'), back, {'icon_left': 'chevron-left'}) }}
                {{ f.submit(__('startseite.signup.confirm'), {'icon_right': 'chevron-right'}) }}
            </div>
        </form>
    </div>

{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script src="{{ url('/startseite/startseite.js') }}"></script>
{% endblock %}
