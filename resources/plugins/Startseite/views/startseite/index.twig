{% extends 'pages/news/index.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}
{% import 'pages/news/index.twig' as n %}

{% block news %}
    {# Pinned news in their order, admins can change it #}
    {% if news is empty %}
        <div class="alert alert-info">{{ __('startseite.news.none') }}</div>
    {% endif %}

    {% for item in news %}
        <div id="news-{{ item.id }}">
            {% if can('admin_news') %}
                <div class="d-flex align-items-center gap-1 mb-1 small">
                    <span class="badge bg-secondary me-1">{{ m.icon('pin-angle') }} {{ loop.index }}</span>
                    <form method="post" action="{{ url('/startseite/news/verschieben') }}">
                        {{ csrf() }}
                        <input type="hidden" name="news_id" value="{{ item.id }}">
                        {{ f.button('', {'type': 'submit', 'name': 'direction', 'value': 'up', 'size': 'sm', 'icon_left': 'arrow-up', 'title': __('startseite.news.up'), 'disabled': loop.first}) }}
                    </form>
                    <form method="post" action="{{ url('/startseite/news/verschieben') }}">
                        {{ csrf() }}
                        <input type="hidden" name="news_id" value="{{ item.id }}">
                        {{ f.button('', {'type': 'submit', 'name': 'direction', 'value': 'down', 'size': 'sm', 'icon_left': 'arrow-down', 'title': __('startseite.news.down'), 'disabled': loop.last}) }}
                    </form>
                    <form method="post" action="{{ url('/startseite/news/anpinnen') }}">
                        {{ csrf() }}
                        <input type="hidden" name="news_id" value="{{ item.id }}">
                        {{ f.button(__('startseite.news.unpin'), {'type': 'submit', 'name': 'pin', 'value': '0', 'size': 'sm', 'icon_left': 'pin', 'btn_type': 'outline-secondary'}) }}
                    </form>
                </div>
            {% endif %}
            {{ n.news(item, true, true) }}
        </div>
    {% endfor %}

    {# Own shifts #}
    <div class="card mb-4 border-primary">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <h2 class="h5 mb-0 me-2">{{ m.icon('calendar-check') }} {{ __('startseite.shifts.title') }}</h2>
            {% if shift_count %}
                <span class="text-muted small">{{ __('startseite.shifts.summary', [shift_count, shift_hours|round(2)]) }}</span>
            {% endif %}
            <div class="ms-auto d-flex flex-wrap gap-2">
                {% if shift_count %}
                    {{ m.button(__('startseite.shifts.pdf'), url('/startseite/dienste.pdf'), {'icon_left': 'file-earmark-pdf', 'size': 'sm'}) }}
                {% endif %}
                {% if can('startseite.signup') %}
                    {% if has_choice %}
                        {{ m.button(__('startseite.signup.table'), url('/startseite/eintragen/auswahl'), {'icon_left': 'table', 'size': 'sm'}) }}
                    {% endif %}
                    {{ m.button(
                        has_choice ? __('startseite.signup.adjust') : __('startseite.signup.start'),
                        url('/startseite/eintragen'),
                        {'type': 'primary', 'icon_left': 'magic', 'size': 'sm'}
                    ) }}
                {% endif %}
            </div>
        </div>

        {% if shift_days is empty %}
            <div class="card-body">
                <p class="mb-0">{{ __('startseite.shifts.none') }}</p>
                {% if can('startseite.signup') %}
                    <p class="mb-0 mt-3">
                        {{ m.button(__('startseite.signup.start'), url('/startseite/eintragen'), {'type': 'primary', 'icon_left': 'magic'}) }}
                    </p>
                {% endif %}
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th class="ps-3">{{ __('startseite.column.time') }}</th>
                            <th>{{ __('startseite.column.location') }}</th>
                            <th>{{ __('startseite.column.angel_type') }}</th>
                            <th class="text-end pe-3">{{ __('startseite.column.hours') }}</th>
                        </tr>
                    </thead>
                    {% for day in shift_days %}
                        <tbody>
                            <tr class="table-secondary">
                                <th colspan="3" class="ps-3">{{ day.label }}</th>
                                <th class="text-end pe-3">{{ day.hours|round(2) }} h</th>
                            </tr>
                            {% for entry in day.entries %}
                                <tr{% if entry.past %} class="text-muted"{% endif %}>
                                    <td class="ps-3 text-nowrap fw-semibold">{{ entry.time }}</td>
                                    <td>{{ entry.location }}</td>
                                    <td>
                                        {{ entry.angel_type }}
                                        {% if entry.title %}<span class="text-muted small">· {{ entry.title }}</span>{% endif %}
                                    </td>
                                    <td class="text-end pe-3 text-nowrap">{{ entry.hours|round(2) }} h</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    {% endfor %}
                </table>
            </div>
        {% endif %}
    </div>

    {% if can('admin_news') and unpinned is not empty %}
        <details class="card mb-4">
            <summary class="card-header">
                {{ __('startseite.news.unpinned', [unpinned|length]) }}
            </summary>
            <ul class="list-group list-group-flush">
                {% for item in unpinned %}
                    <li class="list-group-item d-flex align-items-center gap-2">
                        <a href="{{ url('/news/' ~ item.id) }}" class="me-auto">
                            {% if item.is_meeting %}{{ __('news.is_meeting') }}{% endif %}
                            {{ item.title }}
                        </a>
                        <span class="text-muted small text-nowrap">{{ item.updated_at.format(__('general.date')) }}</span>
                        <form method="post" action="{{ url('/startseite/news/anpinnen') }}">
                            {{ csrf() }}
                            <input type="hidden" name="news_id" value="{{ item.id }}">
                            {{ f.button(__('startseite.news.pin'), {'type': 'submit', 'name': 'pin', 'value': '1', 'size': 'sm', 'icon_left': 'pin-angle', 'btn_type': 'primary'}) }}
                        </form>
                    </li>
                {% endfor %}
            </ul>
        </details>
    {% endif %}
{% endblock %}
