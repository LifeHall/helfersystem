{% extends 'layouts/app.twig' %}
{% import 'macros/base.twig' as m %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ __('startseite.auto.title') }}{% endblock %}

{% block content %}
    <div class="container">
        <h1>{{ m.back(url('/startseite/eintragen/tage', {'modus': 'auto'})) }} {{ block('title') }}</h1>
        {% include 'startseite/_steps.twig' %}
        {% include 'layouts/parts/messages.twig' %}

        <p>{{ __('startseite.auto.info') }}</p>

        <form method="post" action="{{ url('/startseite/automatisch/speichern') }}">
            {{ csrf() }}

            <div class="card mb-4">
                <div class="card-header">{{ __('startseite.auto.windows') }}</div>
                <ul class="list-group list-group-flush">
                    {% for day, row in rows %}
                        <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
                            <span class="flex-grow-1 fw-semibold">{{ row.label }}</span>
                            <label class="visually-hidden" for="from-{{ day }}">{{ __('startseite.auto.from') }}</label>
                            <select class="form-select form-select-sm w-auto" name="from[{{ day }}]" id="from-{{ day }}">
                                {% for minutes in row.starts %}
                                    <option value="{{ minutes }}"{% if minutes == row.from %} selected{% endif %}>{{ row.start_labels[loop.index0] }}</option>
                                {% endfor %}
                            </select>
                            <span>–</span>
                            <label class="visually-hidden" for="to-{{ day }}">{{ __('startseite.auto.to') }}</label>
                            <select class="form-select form-select-sm w-auto" name="to[{{ day }}]" id="to-{{ day }}">
                                {% for minutes in row.ends %}
                                    <option value="{{ minutes }}"{% if minutes == row.to %} selected{% endif %}>{{ row.end_labels[loop.index0] }}</option>
                                {% endfor %}
                            </select>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="mb-4" style="max-width: 20rem">
                <label class="form-label fw-semibold" for="count">{{ __('startseite.auto.count') }}</label>
                <input type="number" class="form-control" name="count" id="count" min="1" max="{{ max }}" value="{{ count }}" required>
                <div class="form-text">{{ __('startseite.auto.count.info') }}</div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                {{ m.button(__('startseite.signup.back'), url('/startseite/eintragen/tage', {'modus': 'auto'}), {'icon_left': 'chevron-left'}) }}
                {{ f.submit(__('startseite.auto.submit'), {'icon_left': 'magic'}) }}
            </div>
        </form>

        {% if has_wish %}
            <form method="post" action="{{ url('/startseite/automatisch/loeschen') }}" class="mt-4">
                {{ csrf() }}
                {{ f.button(__('startseite.auto.delete'), {
                    'type': 'submit',
                    'btn_type': 'outline-danger',
                    'size': 'sm',
                    'icon_left': 'x-lg',
                    'confirm_title': __('startseite.auto.delete'),
                    'confirm_text': __('startseite.auto.delete.info'),
                    'confirm_button_text': __('startseite.auto.delete'),
                }) }}
            </form>
        {% endif %}
    </div>
{% endblock %}
